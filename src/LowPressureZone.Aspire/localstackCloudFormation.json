{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "S3 archive bucket. Upload objects under archive/, listening-party/, and prerecords/ to populate the virtual directories.",
  "Resources": {
    "ArchiveBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "lpz-archive"
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Description": "Name of the archive bucket",
      "Value": {
        "Ref": "ArchiveBucket"
      }
    },
    "ArchivePrefix": {
      "Description": "Object-key prefix for archives",
      "Value": "archive/"
    },
    "ListeningPartyPrefix": {
      "Description": "Object-key prefix for listening parties",
      "Value": "listening-party/"
    },
    "PrerecordsPrefix": {
      "Description": "Object-key prefix for prerecords",
      "Value": "prerecords/"
    }
  }
}